{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mekoniq.local/schemas/project-v1.json",
  "title": "ProjectRevision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "projectId",
    "revision",
    "name",
    "createdAt",
    "updatedAt",
    "location",
    "instances",
    "edges",
    "roofFaces",
    "priceSelections",
    "snapshots"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "projectId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "location": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "latitude",
        "longitude",
        "timezone"
      ],
      "properties": {
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "timezone": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "instances": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "instanceId",
          "kind",
          "label",
          "componentRef"
        ],
        "properties": {
          "instanceId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"
          },
          "kind": {
            "enum": [
              "panel",
              "inverter",
              "battery",
              "controller",
              "load"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "componentRef": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "modelId",
              "revision"
            ],
            "properties": {
              "modelId": {
                "type": "string",
                "minLength": 1
              },
              "revision": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "edgeId",
          "from",
          "to"
        ],
        "properties": {
          "edgeId": {
            "type": "string",
            "minLength": 1
          },
          "from": {
            "$ref": "#/definitions/endpoint"
          },
          "to": {
            "$ref": "#/definitions/endpoint"
          }
        }
      }
    },
    "roofFaces": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "roofFaceId",
          "label",
          "outline",
          "holes",
          "tiltDeg",
          "azimuthDeg",
          "origin",
          "setbackM",
          "setbackSource"
        ],
        "properties": {
          "roofFaceId": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "outline": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number"
              }
            }
          },
          "holes": {
            "type": "array",
            "items": {
              "type": "array",
              "minItems": 3,
              "items": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number"
                }
              }
            }
          },
          "tiltDeg": {
            "type": "number",
            "minimum": 0,
            "maximum": 89.9
          },
          "azimuthDeg": {
            "type": "number",
            "minimum": 0,
            "exclusiveMaximum": 360
          },
          "origin": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "e",
              "n",
              "up"
            ],
            "properties": {
              "e": {
                "type": "number"
              },
              "n": {
                "type": "number"
              },
              "up": {
                "type": "number"
              }
            }
          },
          "setbackM": {
            "type": "number",
            "minimum": 0,
            "maximum": 5
          },
          "setbackSource": {
            "enum": [
              "assumption",
              "user"
            ]
          }
        }
      }
    },
    "priceSelections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "componentRef",
          "offerId"
        ],
        "properties": {
          "componentRef": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "modelId",
              "revision"
            ],
            "properties": {
              "modelId": {
                "type": "string",
                "minLength": 1
              },
              "revision": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "offerId": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "snapshots": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "components",
        "offers"
      ],
      "properties": {
        "components": {
          "type": "array",
          "items": {
            "$ref": "component-v1.json"
          }
        },
        "offers": {
          "type": "array",
          "items": {
            "$ref": "offer-v1.json"
          }
        }
      }
    },
    "costLines": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "lineId",
          "category",
          "label",
          "qty",
          "qtyUnit",
          "unitPriceMinor",
          "vat",
          "seller",
          "recordedAt"
        ],
        "properties": {
          "lineId": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "enum": [
              "equipment",
              "frame",
              "cable",
              "protection",
              "labor",
              "shipping",
              "discount",
              "other"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "qty": {
            "type": "integer",
            "minimum": 1
          },
          "qtyUnit": {
            "enum": [
              "piece",
              "mm"
            ]
          },
          "unitPriceMinor": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^\\d+$"
          },
          "vat": {
            "enum": [
              "included",
              "excluded",
              "unknown"
            ]
          },
          "seller": {
            "type": [
              "string",
              "null"
            ]
          },
          "recordedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "kits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kitId",
          "label",
          "count",
          "parts",
          "priceMinor",
          "vat",
          "seller",
          "recordedAt",
          "covers"
        ],
        "properties": {
          "kitId": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "count": {
            "type": "integer",
            "minimum": 1
          },
          "parts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "componentRef",
                "qty"
              ],
              "properties": {
                "componentRef": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "modelId",
                    "revision"
                  ],
                  "properties": {
                    "modelId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "revision": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                },
                "qty": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "priceMinor": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^\\d+$"
          },
          "vat": {
            "enum": [
              "included",
              "excluded",
              "unknown"
            ]
          },
          "seller": {
            "type": [
              "string",
              "null"
            ]
          },
          "recordedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "covers": {
            "type": "array",
            "items": {
              "enum": [
                "equipment",
                "frame",
                "cable",
                "protection",
                "labor",
                "shipping",
                "discount",
                "other"
              ]
            }
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "quote": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "vatRateBp": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "requiredCategories": {
          "type": "array",
          "items": {
            "enum": [
              "equipment",
              "frame",
              "cable",
              "protection",
              "labor",
              "shipping",
              "discount",
              "other"
            ]
          }
        },
        "waived": {
          "type": "array",
          "items": {
            "enum": [
              "equipment",
              "frame",
              "cable",
              "protection",
              "labor",
              "shipping",
              "discount",
              "other"
            ]
          }
        }
      }
    },
    "strings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stringId",
          "label",
          "panelIds",
          "target"
        ],
        "properties": {
          "stringId": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "panelIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "target": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "instanceId",
              "port"
            ],
            "properties": {
              "instanceId": {
                "type": "string",
                "minLength": 1
              },
              "port": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "design": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "coldCellTempC": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -90,
          "maximum": 60
        },
        "hotCellTempC": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -20,
          "maximum": 150
        },
        "iscFactor": {
          "type": "number",
          "minimum": 1,
          "maximum": 3
        },
        "betaVmpAssumption": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -0.05,
          "maximum": 0.05
        },
        "source": {
          "type": "string"
        }
      }
    },
    "pv": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tiltDeg": {
          "type": "number",
          "minimum": 0,
          "maximum": 90
        },
        "azimuthDeg": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 360
        },
        "albedo": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "lossRatio": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 1
        },
        "cellModel": {
          "enum": [
            "faiman",
            "fixed"
          ]
        },
        "fixedCellTempC": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -40,
          "maximum": 120
        },
        "faimanU0": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "faimanU1": {
          "type": "number",
          "minimum": 0,
          "maximum": 50
        },
        "windFallbackMs": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 50
        },
        "irradianceInput": {
          "enum": [
            "auto",
            "components",
            "poa"
          ]
        },
        "weatherId": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "sim": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minSoc": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "soc0": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "etaCharge": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "etaDischarge": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "inverterEfficiency": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "standbyW": {
          "type": "number",
          "minimum": 0
        },
        "gridAvailable": {
          "type": "boolean"
        },
        "importAllowed": {
          "type": "boolean"
        },
        "exportAllowed": {
          "type": "boolean"
        },
        "outageLocalHours": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 23
          },
          "uniqueItems": true
        }
      }
    },
    "loadPlans": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "instanceId",
          "fractions",
          "priority"
        ],
        "properties": {
          "instanceId": {
            "type": "string",
            "minLength": 1
          },
          "fractions": {
            "type": "array",
            "minItems": 24,
            "maxItems": 24,
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "priority": {
            "type": "integer",
            "minimum": 1,
            "maximum": 99
          },
          "pump": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "staticHeadM",
              "frictionK",
              "curve"
            ],
            "properties": {
              "staticHeadM": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "frictionK": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "curve": {
                "type": [
                  "object",
                  "null"
                ],
                "additionalProperties": false,
                "required": [
                  "qM3h",
                  "headM"
                ],
                "properties": {
                  "qM3h": {
                    "type": "array",
                    "minItems": 2,
                    "items": {
                      "type": "number",
                      "minimum": 0
                    }
                  },
                  "headM": {
                    "type": "array",
                    "minItems": 2,
                    "items": {
                      "type": "number",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "placements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "instanceId",
          "roofFaceId",
          "center",
          "angleDeg"
        ],
        "properties": {
          "instanceId": {
            "type": "string",
            "minLength": 1
          },
          "roofFaceId": {
            "type": "string",
            "minLength": 1
          },
          "center": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number"
            }
          },
          "angleDeg": {
            "type": "number"
          }
        }
      }
    },
    "obstacles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "obstacleId",
          "label",
          "kind",
          "roofFaceId",
          "center",
          "baseUp",
          "angleDeg",
          "size"
        ],
        "properties": {
          "obstacleId": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "box",
              "cylinder"
            ]
          },
          "roofFaceId": {
            "type": [
              "string",
              "null"
            ]
          },
          "center": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "e",
              "n"
            ],
            "properties": {
              "e": {
                "type": "number"
              },
              "n": {
                "type": "number"
              }
            }
          },
          "baseUp": {
            "type": "number"
          },
          "angleDeg": {
            "type": "number"
          },
          "size": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "x",
              "y",
              "z"
            ],
            "properties": {
              "x": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "y": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "z": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gridM": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "gapM": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  },
  "definitions": {
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instanceId",
        "port"
      ],
      "properties": {
        "instanceId": {
          "type": "string",
          "minLength": 1
        },
        "port": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
