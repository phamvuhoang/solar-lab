{
  "name": "mekoniq-solar-lab",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/build-meta.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "check:imports": "node scripts/check-imports.mjs",
    "ci": "pnpm check:imports && pnpm typecheck && pnpm test && pnpm test:unit && pnpm build && pnpm test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "fake-indexeddb": "6.2.4",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vitest": "4.1.12"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  }
}
